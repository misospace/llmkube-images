{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>misospace/renovate-config"],
  customManagers: [
    {
      customType: "regex",
      description: "Process Annotations in Docker Bake",
      managerFilePatterns: ["/(^|/)docker-bake\\.hcl$/"],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+ = "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      customType: "regex",
      description: "Process Annotations in Dockerfiles",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],
  packageRules: [
    {
      description: ["Release rules for app image updates"],
      addLabels: ["app/{{parentDir}}"],
      additionalBranchPrefix: "{{parentDir}}-",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
      commitMessageTopic: "{{depName}}",
      matchFileNames: ["**/docker-bake.hcl", "**/Dockerfile"],
      semanticCommitScope: "{{parentDir}}",
      semanticCommitType: "release",
    },
    {
      description: ["Auto-merge image updates once CI (build + tests) is green"],
      matchFileNames: ["**/docker-bake.hcl", "**/Dockerfile"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: [
        "LLMKube coder image — one PR per LLMKube release.",
        "matchDepNames is load-bearing: apps/llmkube-coder/ holds ten annotated",
        "dependencies (godot, hex, rebar3, ruff, black, flake8, yamllint,",
        "eslint and the node base image alongside llmkube). Matching the",
        "directory alone swept all of them into this group and titled the",
        "result after it, so a Ruff patch bump shipped as release(llmkube-coders).",
        "Everything else falls through to the per-app release rule above and",
        "gets its own PR named after its own dependency.",
      ],
      matchFileNames: ["apps/llmkube-coder/**"],
      matchDepNames: ["defilantech/llmkube"],
      groupName: "llmkube-coders",
      additionalBranchPrefix: "",
      addLabels: ["app/llmkube-coders"],
      commitMessageTopic: "{{groupName}}",
      semanticCommitScope: "llmkube-coders",
    },
    {
      description: [
        "Hold typescript on 6.x in the coder image. TypeScript 7 is the native",
        "Go port and its npm package ships compiled binaries vendoring",
        "golang.org/x/text v0.38.0, which Grype flags as GO-2026-5970 (High,",
        "fixed in 0.39.0) and the pre-publish gate blocks. npm audit cannot see",
        "it: it reads package trees, not binaries. Lift this once TypeScript",
        "ships a build with x/text >= 0.39.0.",
      ],
      matchFileNames: ["apps/llmkube-coder/**"],
      matchDepNames: ["typescript"],
      allowedVersions: "<7",
    },
    {
      description: ["Auto-merge Go module dependency updates once CI is green"],
      matchFileNames: ["**/go.mod"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      addLabels: ["type/deps"],
      semanticCommitType: "fix",
      semanticCommitScope: "deps",
    },
  ],
}
